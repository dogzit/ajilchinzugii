# ─────────────────────────────────────────────────────────────────────────────
# Ажилчин Зөгий — орчны хувьсагчид / environment variables
#
# Хуулбарлаад бөглө: cp .env.example .env.local
# Бүх данс байгууллагынх (CLAUDE.md 10-р дүрэм). Хөгжүүлэгчийн хувийн данс
# ашиглахыг хориглоно.
#
# Copy to .env.local and fill in. Every account belongs to the client.
#
# ⚠ NEXT_PUBLIC_ префикстэй утгууд нь build хийх үед кодод шигтгэгддэг.
#   Vercel дээр тэдгээрийг build-ээс ӨМНӨ тавьсан байх ёстой.
# ─────────────────────────────────────────────────────────────────────────────


# ── 1. Сайт / Site ───────────────────────────────────────────────────────────

# Сайтын бүтэн хаяг, төгсгөлийн зураасгүй. Canonical, hreflang, sitemap,
# JSON-LD, share зураг бүгд эндээс бүтнэ. Тохируулаагүй бол production build
# алдаа заан зогсоно.
# Where: Vercel → Project → Settings → Environment Variables
NEXT_PUBLIC_SITE_URL=https://example.org

# Холбоо барих и-мэйл. Сайт дээр сонгож болох текстээр харагдана (форм байхгүй).
# CMS дэх Site тохиргоонд бичсэн утга нэн тэргүүнд хэрэглэгдэнэ; энэ нь нөөц.
# Хэнийх: байгууллагын и-мэйл данс.
NEXT_PUBLIC_CONTACT_EMAIL=info@example.org

# Нэг каноник хост сонгох: www → apex эсвэл эсрэгээр.
# Жишээ: ajilchinzugii.mn (www-г apex руу явуулна)
#        www.ajilchinzugii.mn (apex-ийг www руу явуулна)
# Хоосон бал redirect нэмэгдэхгүй (preview deploy-д тохиромжтой).
SITE_CANONICAL_HOST=

# Хуучин домэйноос шилжих үед: таслалаар тусгаарла. Эдгээр хост руу ирсэн
# хүсэлтийг каноник хост руу 301-ээр буцаана.
# Жишээ: old-domain.mn,www.old-domain.mn
OLD_HOSTS=


# ── 2. Payload CMS ───────────────────────────────────────────────────────────

# Админы session, токеныг гарын үсэглэнэ. Солих юм бол бүх хэрэглэгч гарна.
# Үүсгэх: openssl rand -hex 32
# Хэнийх: байгууллагын нууц (Vercel-д хадгална, репод хэзээ ч биш).
PAYLOAD_SECRET=

# `pnpm seed` эхний админ данс үүсгэхэд л ашиглана. Дараа нь хоосон орхи.
# Хэнийх: байгууллагын админ хүн өөрөө оруулна.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=


# ── 3. Neon Postgres ─────────────────────────────────────────────────────────
# Хаана авах: https://console.neon.tech → Project → Connection Details
# Хэнийх: байгууллагын Neon данс.

# Pooled (`-pooler` хосттой) — ажиллаж буй сайт үүнийг хэрэглэнэ.
# sslmode=verify-full байлга: сервертийн гэрчилгээг жинхэнээр шалгана.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=verify-full

# Direct (`-pooler` -гүй, ижил хост) — migration болон шөнийн backup үүнийг
# хэрэглэнэ. pg_dump pooler-ээр ажиллахгүй.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=verify-full


# ── 4. Cloudflare R2 — зураг, файлын сан ─────────────────────────────────────
# Хаана авах: Cloudflare dashboard → R2 → Manage API tokens
# Хэнийх: байгууллагын Cloudflare данс.
# ⚠ Эдгээрийг NEXT_PUBLIC_ болгож болохгүй — browser руу гарч, хэн ч уншина.

R2_ACCOUNT_ID=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Үндсэн bucket: сайтын зураг, PDF.
R2_BUCKET=

# Нөөцлөлтийн bucket — ӨӨР bucket байх ёстой. Үндсэн bucket уствал нөөц нь
# түүнтэй хамт устахгүй байхын тулд.
R2_BACKUP_BUCKET=

# Файлыг уншихад хэрэглэх нийтийн хаяг: bucket-ийн r2.dev дэд домэйн эсвэл
# өөрийн домэйн. Хоосон байхад зураг Payload-ийн өөрийн замаар үйлчлэгдэнэ
# (ажиллана, гэхдээ таны серверээр дамжина).
R2_PUBLIC_URL=

# Cloudflare-ийн аккаунт түвшний API token. Bucket удирдах, wrangler-т.
# Ажиллаж буй сайт үүнийг уншдаггүй.
CLOUDFLARE_API_TOKEN=


# ── 5. Нөлөөллийн тоо — Google Sheets ────────────────────────────────────────
# Хаана авах: Google Cloud Console → IAM → Service Accounts → Keys (JSON)
# Хэнийх: байгууллагын Google данс.
# ⚠ Зөвхөн "НИЙТИЙН НИЙЛБЭР" хүснэгтийг энэ хаягтай Viewer эрхээр хуваалц.
#   Хэргийн бүртгэлийг ХЭЗЭЭ Ч хуваалцахгүй (CLAUDE.md 3-р дүрэм).

GOOGLE_SA_EMAIL=
# PEM түлхүүр. \n-ийг хэвээр нь, хашилттай нь нэг мөрөнд бич.
GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"
# Хүснэгтийн URL дэх /d/<id>/ хэсэг.
IMPACT_SHEET_ID=


# ── 6. Шинэчлэлт / Revalidation ──────────────────────────────────────────────

# POST /api/revalidate дуудахад x-revalidate-secret толгойд явуулна.
# Үүсгэх: openssl rand -hex 24
REVALIDATE_SECRET=

# Vercel cron үүнийг Bearer токеноор автоматаар явуулна (vercel.json: 22:00 UTC
# = Улаанбаатарын 06:00). Vercel төсөл дээр тавина.
# Хаана: Vercel → Settings → Environment Variables → CRON_SECRET
CRON_SECRET=


# ── 7. Хайлтын систем ба тоолуур ─────────────────────────────────────────────

# Google Search Console баталгаажуулах meta тагийн агуулга.
# Хаана авах: search.google.com/search-console → Add property → HTML tag
# Хэнийх: байгууллагын Google данс.
NEXT_PUBLIC_GSC_VERIFICATION=

# Plausible дээр бүртгүүлсэн домэйн, жишээ: ajilchinzugii.mn
# Хоосон бол тоолуурын скрипт огт ачаалагдахгүй.
# Plausible cookie тавьдаггүй тул зөвшөөрлийн самбар шаардахгүй.
# Хэнийх: байгууллагын Plausible данс.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Өөрөө host хийж байгаа бол л бөглө. Анхдагч нь https://plausible.io
NEXT_PUBLIC_PLAUSIBLE_HOST=


# ── 8. Захидал (SMTP) ───────────────────────────────────────────────────────
# Админ хэсэг ганц төрлийн захидал илгээнэ: «нууц үг сэргээх» холбоос.
# Эдгээрийг бөглөхгүй бол Payload захидлыг зөвхөн логт бичнэ — өөрөөр хэлбэл
# «Forgot password» чимээгүйхэн ажиллахгүй.
#
# Ямар ч SMTP үйлчилгээ болно. Жишээ тохиргоо:
#   Gmail       smtp.gmail.com : 587   (app password хэрэгтэй, энгийн нууц үг БИШ)
#   Resend      smtp.resend.com : 587  (хэрэглэгч нь «resend», нууц үг нь API key)
#   Brevo       smtp-relay.brevo.com : 587
# Хэнийх: байгууллагын шуудангийн данс. Шөнийн нөөцлөлт мөн яг эдгээр нэрийг
# ашигладаг тул нэг данс хоёуланд нь үйлчилнэ.
SMTP_HOST=
# 465 бол шууд TLS, 587 бол STARTTLS. Хоосон бол 587.
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Илгээгчийн хаяг. Ихэнх үйлчилгээ SMTP_USER-ээс өөр хаягийг татгалздаг тул
# хоосон бол SMTP_USER-ийг ашиглана.
SMTP_FROM=
# Илгээгчийн харагдах нэр. Хоосон бол «Ажилчин Зөгий».
SMTP_FROM_NAME=


# ── 9. Шөнийн нөөцлөлт (зөвхөн GitHub Actions secrets) ───────────────────────
# Эдгээрийг .env.local-д биш, GitHub → Settings → Secrets and variables →
# Actions дотор хадгална. Дэлгэрэнгүй: docs/RESTORE.md
#
#   DATABASE_URL_UNPOOLED   — дээрхтэй ижил
#   R2_ACCOUNT_ID / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY
#   R2_BUCKET               — зургийн bucket (долоо хоног тутмын хуулбарт)
#   R2_BACKUP_BUCKET        — нөөцийн bucket
#   BACKUP_ALERT_EMAIL      — алдаа гарвал мэдэгдэх хаяг
#   SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASSWORD  — мэдэгдэл илгээх
