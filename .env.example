# Copy to .env.local and fill in. Never commit real values.

# ── Site ──────────────────────────────────────────────────────────────────
# Public base URL, no trailing slash. The domain lives here, never in code.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact address shown as selectable text in the footer (no forms).
NEXT_PUBLIC_CONTACT_EMAIL=info@example.org

# ── Payload CMS ───────────────────────────────────────────────────────────
# Signs admin sessions and tokens. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# Optional: used once by `pnpm seed` to create the first admin account.
# The account belongs to the client — never commit real credentials.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── Neon Postgres ─────────────────────────────────────────────────────────
# Pooled URL (-pooler host) for the running app. Keep sslmode=verify-full so
# the server certificate is actually verified.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=verify-full
# Direct URL (same host without -pooler) for migrations and schema work.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=verify-full

# ── Cloudflare R2 — media storage (S3-compatible) ─────────────────────────
# Server-side only. Never rename these to NEXT_PUBLIC_*: that would ship the
# credentials to every visitor's browser.
R2_ACCOUNT_ID=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL for reading objects: r2.dev subdomain or a custom domain.
# While empty, media is served through Payload's own route.
R2_PUBLIC_URL=

# Account-level Cloudflare API token, for bucket administration and wrangler.
# Not read by the running site.
CLOUDFLARE_API_TOKEN=
