# Copy to .env.local and fill in. Never commit real values.

# ── Site ──────────────────────────────────────────────────────────────────
# Public base URL, no trailing slash. The domain lives here, never in code.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact address shown as selectable text in the footer (no forms).
NEXT_PUBLIC_CONTACT_EMAIL=info@example.org

# ── Cloudflare R2 — media storage (S3-compatible), used from phase 3 ──────
# Server-side only. Never rename these to NEXT_PUBLIC_*: that would ship the
# credentials to every visitor's browser.
R2_ACCOUNT_ID=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL for reading objects: r2.dev subdomain or a custom domain.
R2_PUBLIC_BASE_URL=

# Account-level Cloudflare API token, for bucket administration and wrangler.
# Not read by the running site.
CLOUDFLARE_API_TOKEN=
