{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ajilchinzugii",
  // A thin wrapper round the generated worker that adds the cron
  // handler; see worker/index.js.
  "main": "worker/index.js",

  // OpenNext's own default. Not today's date on purpose: the adapter is
  // tested against this one, and a newer date can switch on runtime
  // behaviour the adapter has not caught up with.
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // The worker calls itself for cache revalidation.
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ajilchinzugii"
    }
  ],

  // No R2 incremental-cache binding. Its presence is what makes
  // `opennextjs-cloudflare deploy` run its "Populating remote R2 incremental
  // cache" step, which hangs indefinitely with this account's API token —
  // no error, no progress, object_count stays 0. See open-next.config.ts.

  // Resizing and format conversion for next/image, which Vercel used to do
  // and the Workers runtime cannot: `sharp` is a native binary and does not
  // run here.
  "images": {
    "binding": "IMAGES"
  },

  // The daily revalidation of the impact figures, at the same hour the
  // Vercel cron ran it. A cron trigger calls `scheduled`, not a URL.
  "triggers": {
    "crons": ["0 22 * * *"]
  },

  "observability": {
    "enabled": true
  }
}
