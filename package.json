{
  "name": "ajilchin-zugii",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate:create": "DATABASE_MIGRATING=true payload migrate:create",
    "migrate": "DATABASE_MIGRATING=true payload migrate",
    "migrate:status": "DATABASE_MIGRATING=true payload migrate:status",
    "seed": "payload run src/payload/seed.ts",
    "seed:org": "payload run src/payload/seed-org.ts",
    "lhci": "lhci autorun",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "seed:demo": "payload run src/payload/seed-demo.ts",
    "seed:demo:clear": "payload run src/payload/seed-demo.ts -- --clear",
    "check:placeholders": "payload run scripts/check-placeholders.ts",
    "prebuild": "if [ \"$NEXT_PUBLIC_ALLOW_INDEXING\" = \"true\" ]; then pnpm check:placeholders; fi",
    "build:cf": "BUILD_TARGET=cloudflare opennextjs-cloudflare build",
    "preview:cf": "BUILD_TARGET=cloudflare opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cf": "BUILD_TARGET=cloudflare opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "migrate:d1": "DATABASE_MIGRATING=true DB_DRIVER=d1 NEXT_RUNTIME=nodejs CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=$(grep -m1 '^DATABASE_URL_UNPOOLED=' .env.local | cut -d= -f2- | tr -d '\"') payload migrate",
    "migrate:create:d1": "DATABASE_MIGRATING=true DB_DRIVER=d1 NEXT_RUNTIME=nodejs CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=$(grep -m1 '^DATABASE_URL_UNPOOLED=' .env.local | cut -d= -f2- | tr -d '\"') payload migrate:create",
    "migrate:status:d1": "DATABASE_MIGRATING=true DB_DRIVER=d1 NEXT_RUNTIME=nodejs CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=$(grep -m1 '^DATABASE_URL_UNPOOLED=' .env.local | cut -d= -f2- | tr -d '\"') payload migrate:status",
    "migrate:fresh:d1": "DATABASE_MIGRATING=true DB_DRIVER=d1 NEXT_RUNTIME=nodejs CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=$(grep -m1 '^DATABASE_URL_UNPOOLED=' .env.local | cut -d= -f2- | tr -d '\"') payload migrate:fresh",
    "copy:d1": "payload run scripts/copy-neon-to-d1.ts"
  },
  "dependencies": {
    "@payloadcms/db-d1-sqlite": "3.93.0",
    "@payloadcms/db-postgres": "^3.93.0",
    "@payloadcms/email-nodemailer": "^3.93.0",
    "@payloadcms/next": "^3.93.0",
    "@payloadcms/richtext-lexical": "^3.93.0",
    "@payloadcms/storage-s3": "^3.93.0",
    "@payloadcms/ui": "^3.93.0",
    "google-auth-library": "^11.3.1",
    "graphql": "^16.14.2",
    "next": "^16.4.3",
    "next-intl": "^4.14.9",
    "payload": "^3.93.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3.3.7",
    "@lhci/cli": "^0.15.1",
    "@opennextjs/cloudflare": "^1.20.16",
    "@playwright/test": "^1.64.1",
    "@swc-node/register": "^1.12.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "schema-dts": "^2.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.158.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "sharp",
      "unrs-resolver",
      "workerd"
    ]
  }
}
