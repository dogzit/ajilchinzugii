    "@payloadcms/storage-s3": "^3.92.0",
    "@payloadcms/ui": "^3.92.0",
    "google-auth-library": "^11.3.1",
    "graphql": "^16.14.2",
    "next": "^16.4.3",
    "next-intl": "^4.14.9",
    "payload": "^3.92.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
