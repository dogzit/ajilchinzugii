{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "if [ \"$VERCEL_ENV\" = \"production\" ]; then pnpm migrate; fi && pnpm build",
  "crons": [
    {
      "path": "/api/revalidate",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/cases/purge",
      "schedule": "0 22 * * *"
    }
  ]
}
